{
    "editor.accessibilitySupport": "on",
    "editor.inlineSuggest.enabled": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.chat.edits.temporalContext.enabled": true,
    "git.autofetch": true,
    "powershell.pester.codeLens": false,
    "git.replaceTagsWhenPull": true,
    "powershell.codeFormatting.newLineAfterCloseBrace": true,
    "powershell.codeFormatting.autoCorrectAliases": true,
    "powershell.codeFormatting.avoidSemicolonsAsLineTerminators": true,
    "powershell.codeFormatting.trimWhitespaceAroundPipe": true,
    "powershell.codeFormatting.useCorrectCasing": true,
    "powershell.codeFormatting.whitespaceBetweenParameters": true,
    "powershell.codeFormatting.whitespaceInsideBrace": false,
    "powershell.codeFormatting.openBraceOnSameLine": false,
    "powershell.codeFormatting.pipelineIndentationStyle": "IncreaseIndentationForFirstPipeline",
    "powershell.codeFolding.enable": true,
    "powershell.suppressAdditionalExeNotFoundWarning": false,
    "workbench.startupEditor": "none",
    "update.showReleaseNotes": false,
    "github.copilot.chat.agent.thinkingTool": true,
    "github.copilot.chat.codesearch.enabled": true,
    "github.copilot.chat.languageContext.fix.typescript.enabled": true,
    "github.copilot.chat.languageContext.inline.typescript.enabled": true,
    "chat.agent.enabled": true,
    "editor.formatOnSave": true,
    "security.workspace.trust.enabled": false,
    "inlineChat.enableV2": true,
    "inlineChat.hideOnRequest": true,
    "terminal.integrated.focusAfterRun": "accessible-buffer",
    "powershell.pester.useLegacyCodeLens": false,
    "terminal.integrated.enableVisualBell": true,
    "terminal.integrated.localEchoEnabled": "auto",
    "terminal.integrated.shellIntegration.environmentReporting": true,
    "terminal.integrated.automationProfile.windows": {
        "path": "$env:programfiles\\PowerShell\\7\\pwsh.exe",
        "icon": "terminal-powershell"
    },
    "powershell.analyzeOpenDocumentsOnly": true,
    "workbench.settings.showAISearchToggle": true,
    "search.searchView.keywordSuggestions": true,
    "search.searchView.semanticSearchBehavior": "runOnEmpty",
    "chat.todoListTool.enabled": true,
    "github.copilot.chat.newWorkspace.useContext7": true,
    "githubPullRequests.codingAgent.uiIntegration": true,
    "accessibility.verbosity.hover": false,
    "scm.workingSets.enabled": true,
    "scm.defaultViewMode": "tree",
    "terminal.integrated.hideOnStartup": "whenEmpty",
    "workbench.editor.showTabIndex": true,
    "powershell.powerShellAdditionalExePaths": {
        "pwsh": "$env:programfiles\\PowerShell\\7\\pwsh.exe"
    },
    "powershell.powerShellDefaultVersion": "pwsh",
    "editor.inlineSuggest.minShowDelay": 1500,
    "chat.agent.thinkingStyle": "collapsedPreview",
    "chat.emptyState.history.enabled": true,
    "chat.agentSessionsViewLocation": "view",
    "chat.tools.terminal.autoReplyToPrompts": true,
    "chat.mcp.gallery.enabled": true,
    "github.copilot.nextEditSuggestions.allowWhitespaceOnlyChanges": false,
    "task.notifyWindowOnTaskCompletion": 200,
    "terminal.integrated.accessibleViewFocusOnCommandExecution": true,
    "accessibility.verbosity.terminal": false,
    "chat.agent.maxRequests": 75,
    "files.exclude": {
        "*.exe": true
    },
    "chat.tools.terminal.terminalProfile.windows": {
        "path": "$env:programfiles\\PowerShell\\7\\pwsh.exe",
        "args": [
            "-ExecutionPolicy",
            "Bypass",
            "-NoLogo"
        ]
    }
}