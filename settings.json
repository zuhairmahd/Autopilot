        },
        {
            "description": "Troubleshoot a device",
            "name": "Check device status",
            "items": [
                {
                    "description": "Lookup a device by its serial number",
                    "name": "Lookup device by Serial Number",
                    "items": [
                        {
                            "description": "Lookup a device by its serial number",
                            "name": "Enter a serial number",
                            "type": "action",
                            "includeInDisplayModes": []
