                        },
                        {
                            "name": "Change global environment settings",
                            "description": "Change the global environment settings for the application",
                            "type": "action",
                            "includeInDisplayModes": []
                        },
                        {
                            "name": "Change domain specific settings",
                            "description": "Change the domain specific settings for the application",
                            "type": "action",
                            "includeInDisplayModes": []
                        },
                        {
                            "name": "Change authentication settings",
                            "description": "Change the authentication settings (such as authentication type) for the application",
                            "type": "action",
                            "includeInDisplayModes": []
                        },
                        {
                            "name": "Change group inclusion/exclusion",
                            "description": "Edit domain-level group inclusion and exclusion settings",
                            "type": "action",
                            "includeInDisplayModes": []
                        }
                    ],
                    "includeInDisplayModes": []
                },
                {
                    "description": "Change the password and Azure app information",
                    "name": "Change Entra credentials",
                    "type": "action",
                    "includeInDisplayModes": []
                },
                {
                    "description": "Turn Auto Updates on or off",
                    "name": "Change Auto Update setting",
                    "type": "action",
                    "includeInDisplayModes": []
                },
                {
                    "description": "Change the application mode",
                    "name": "Change App Mode setting",
                    "type": "action",
                    "includeInDisplayModes": [
                        "full",
                        "helpDesk",
                        "advanced",
                        "advancedRegistration",
                        "registration",
                        "admin",
                        "custom"
                    ]
                }
            ],
            "type": "submenu",
            "includeInDisplayModes": [
                "advanced"
            ]
        },
        {
            "description": "Check for updates to the scripts used by the application",
            "name": "Check for script updates",
            "type": "action",
            "includeInDisplayModes": []
        },
        {
            "description": "Restart the device",
            "name": "Restart the device",
            "type": "action",
            "includeInDisplayModes": []
