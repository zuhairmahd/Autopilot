{
    "description": "This is the configuration file for the Intune Helpdesk script. It contains the settings for the script to run correctly.",
    "version": "1.1",
    "auth": {
        "changePwOnNextStart": false,
        "authType": "PublicAuthFlow",
        "NoSaveRefreshToken": false,
        "ForceNewToken": false,
        "renewalLeadTime": 5,
        "scope": [
            "offline_access",
            "openid",
            "Device.ReadWrite.All",
            "DeviceManagementApps.Read.All",
            "DeviceManagementConfiguration.ReadWrite.All",
            "DeviceManagementManagedDevices.PrivilegedOperations.All",
            "DeviceManagementManagedDevices.ReadWrite.All",
            "DeviceManagementApps.ReadWrite.All",
            "BitlockerKey.Read.All",
            "User.Read.All",
            "DeviceManagementServiceConfig.ReadWrite.All"
        ],
        "CacheType": "Memory",
        "SecureString": false,
        "Delegated": true
    },
    "requiredScopes": [
        {
            "Scope": "User.Read.All",
            "Reason": "Required to read user profiles, group memberships, registered devices, and user directory information.",
            "Endpoints": [
                "users",
                "users/{id}",
                "users/{id}/memberOf",
                "users/{id}/registeredDevices"
            ]
        },
        {
            "Scope": "Device.Read.All",
            "Reason": "Required to read Microsoft Entra ID device objects and device directory information.",
            "Endpoints": [
                "devices",
                "devices/{id}"
            ]
        },
        {
            "Scope": "DeviceManagementApps.ReadWrite.All",
            "Reason": "Required to read and write mobile application information, app assignments, and app protection policies in Microsoft Intune.",
            "Endpoints": [
                "deviceAppManagement/mobileApps",
                "deviceAppManagement/mobileApps/{id}/assignments",
                "deviceAppManagement/managedAppPolicies"
            ]
        },
        {
            "Scope": "DeviceManagementConfiguration.Read.All",
            "Reason": "Required to read Intune device configuration policies, compliance policies, and settings catalog configurations.",
            "Endpoints": [
                "deviceManagement/deviceConfigurations",
                "deviceManagement/deviceCompliancePolicies",
                "deviceManagement/configurationPolicies"
            ]
        },
        {
            "Scope": "DeviceManagementManagedDevices.Read.All",
            "Reason": "Required to read Intune managed device properties, device health status, and device compliance information.",
            "Endpoints": [
                "deviceManagement/managedDevices",
                "deviceManagement/managedDevices/{id}",
                "deviceManagement/managedDevices/{id}/deviceCompliancePolicyStates"
            ]
        },
        {
            "Scope": "BitlockerKey.Read.All",
            "Reason": "Required to read BitLocker recovery keys for all devices.",
            "Endpoints": [
                "informationProtection/bitlocker/recoveryKeys"
            ]
        },
        {
            "Scope": "DeviceManagementManagedDevices.PrivilegedOperations.All",
            "Reason": "Required for privileged device operations including reading local administrator (LAPS) passwords, device sync, wipe, and restart operations.",
            "Endpoints": [
                "directory/deviceLocalCredentials",
                "deviceManagement/managedDevices/{id}/syncDevice",
                "deviceManagement/managedDevices/{id}/wipe",
                "deviceManagement/managedDevices/{id}/rebootNow"
            ]
        },
        {
            "Scope": "DeviceManagementServiceConfig.ReadWrite.All",
            "Reason": "Required to read and write Intune service configuration including Autopilot events, device identities, and enrollment profiles.",
            "Endpoints": [
                "deviceManagement/autopilotEvents",
                "deviceManagement/importedWindowsAutopilotDeviceIdentities",
                "deviceManagement/windowsAutopilotDeviceIdentities",
                "deviceManagement/windowsAutopilotDeploymentProfiles"
            ]
        },
        {
            "Scope": "openid",
            "Reason": "Standard scope required for user sign-in with OpenID Connect.",
            "Endpoints": []
        },
        {
            "Scope": "profile",
            "Reason": "Standard scope to get basic user profile information during sign-in.",
            "Endpoints": []
        },
        {
            "Scope": "offline_access",
            "Reason": "Standard scope that provides refresh tokens to maintain access when the user is not active.",
            "Endpoints": []
        },
        {
            "Scope": "DeviceManagementConfiguration.ReadWrite.All",
            "Reason": "Required to create, update, and delete Intune device configuration policies and settings catalog configurations.",
            "Endpoints": [
                "deviceManagement/deviceConfigurations",
                "deviceManagement/configurationPolicies",
                "deviceManagement/groupPolicyConfigurations"
            ]
        },
        {
            "Scope": "DeviceManagementApps.Read.All",
            "Reason": "Required to read mobile application information and app assignments in Microsoft Intune.",
            "Endpoints": [
                "deviceAppManagement/mobileApps",
                "deviceAppManagement/mobileApps/{id}/assignments"
            ]
        },
        {
            "Scope": "DeviceManagementManagedDevices.ReadWrite.All",
            "Reason": "Required to create, update, and delete Intune managed device properties and perform device management operations.",
            "Endpoints": [
                "deviceManagement/managedDevices",
                "deviceManagement/managedDevices/{id}",
                "deviceManagement/managedDevices/{id}/retire",
                "deviceManagement/managedDevices/{id}/wipe"
            ]
        },
    ],
    "globalSettings": {
        "operatingSystem": "Windows",
        "Release": "master",
        "Repo": "Github",
        "timeInSeconds": "60",
        "maxUserMatchDisplay": 24,
        "maxGroupMatchDisplay": 24,
        "maxWaitTime": "30",
        "autoUpdate": true,
        "appMode": "full",
        "testMode": false,
        "configFile": ".\\.secrets\\config.json",
        "showLicenseBanner": false,
        "deviceContactThresholdInDays": 30,
        "groupPatternsToExclude": []
    },
    "domains": {
        "arabictutor.com": {
            "groupsToExclude": [
                "admin"
            ],
            "groupsToInclude": [],
            "settings": {
                "operatingSystem": "Windows",
                "repo": "Github",
                "MinUsernameLength": 3,
                "timeInSeconds": "60",
                "DesiredAutopilotProfiles": [
                    "windowsCloudConfig Autopilot profile",
                    "Hybrid join profile"
                ],
                "MaxSerialNumberLength": 100,
                "deviceContactThresholdInDays": 30,
                "GroupTag": "ENTRA",
                "maxWaitTime": "30",
                "showLicenseBanner": true,
                "autoUpdate": true,
                "MinimumDevicePhysicalMemoryInGB": 8,
                "MaxUserNameLength": 50,
                "domain": "arabictutor.com",
                "preferredBrowser": "Chrome",
                "appMode": "full",
                "deviceNamePrefix": "vmware",
                "privateSession": false,
                "maxNumberOfDevicesAllowed": 15,
                "userPatternsToExclude": [
                    "-test",
                    "onmicrosoft.com"
                ],
                "groupPatternsToExclude": [],
                "release": "master",
                "MinSerialNumberLength": 7,
                "maxUserMatchDisplay": "10"
            }
        },
        "gao.gov": {
            "groupsToExclude": [],
            "groupsToInclude": [
                "sg_Office_365_License_G5_wth_windows_pilot",
                "sg_passwrd_hash_stage",
                "ITN-USR-CON-WIN-ENROLLMENT-PROD-ALLMSB",
                "ITN-USR-CON-WIN-ENROLLMENT-PROD-AUTOENROLLMENTENABLED"
            ],
            "settings": {
                "operatingSystem": "Windows",
                "maxNumberOfDevicesAllowed": 20,
                "repo": "Github",
                "timeInSeconds": "60",
                "DesiredAutopilotProfiles": [
                    "msb"
                ],
                "MaxSerialNumberLength": 10,
                "deviceContactThresholdInDays": 30,
                "maxUserMatchDisplay": 24,
                "maxGroupMatchDisplay": 24,
                "maxWaitTime": "30",
                "showLicenseBanner": false,
                "autoUpdate": false,
                "MinimumDevicePhysicalMemoryInGB": 16,
                "MaxUserNameLength": 25,
                "domain": "gao.gov",
                "preferredBrowser": "Chrome",
                "appMode": "full",
                "deviceNamePrefix": "w11-",
                "privateSession": true,
                "MinUsernameLength": 3,
                "userPatternsToExclude": [
                    "-cma",
                    "-test",
                    "onmicrosoft.com",
                    "-sup",
                    "-a"
                ],
                "groupPatternsToExclude": [],
                "release": "master",
                "MinSerialNumberLength": 7,
                "GroupTag": "MSB01"
            }
        }
    },
    "menus": [
        {
            "description": "Start the user and device readiness check",
            "name": "Give a device to a user",
            "type": "action",
            "includeInDisplayModes": [
                "helpdesk",
                "registration"
